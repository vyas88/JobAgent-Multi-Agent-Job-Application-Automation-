{
  "name": "JobAgent - Workflow A: Ingest & Analyze",
  "nodes": [
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "source_url",
              "value": "https://boards.greenhouse.io/testco/jobs/123456"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Manual Trigger (Job URL Input)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JOBAGENT_BASE_URL || 'http://host.docker.internal:8000' }}/jobs/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"source_url\": \"{{ $json.source_url }}\"\n}",
        "options": {
          "neverError": true
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000002",
      "name": "POST /jobs/analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "jobagent-api-key",
          "name": "JobAgent API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $response.statusCode }}",
              "operation": "equal",
              "value2": 200
            }
          ]
        }
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000003",
      "name": "Check Status == 200",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "Job Analyzed Successfully"
            },
            {
              "name": "job_id",
              "value": "={{ $json.job.id }}"
            },
            {
              "name": "job_title",
              "value": "={{ $json.job.title }}"
            },
            {
              "name": "company",
              "value": "={{ $json.job.company }}"
            },
            {
              "name": "outcome",
              "value": "={{ $json.outcome }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000004",
      "name": "Output: Job Analyzed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error_status",
              "value": "={{ $response.statusCode }}"
            },
            {
              "name": "error_detail",
              "value": "={{ $json.detail || 'Failed to analyze job' }}"
            },
            {
              "name": "error_type",
              "value": "={{ $json.error_type || 'parse_or_fill_error' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000005",
      "name": "Error Handler: Ingest Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1000,
        400
      ]
    }
  ],
  "connections": {
    "Manual Trigger (Job URL Input)": {
      "main": [
        [
          {
            "node": "POST /jobs/analyze",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /jobs/analyze": {
      "main": [
        [
          {
            "node": "Check Status == 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Status == 200": {
      "main": [
        [
          {
            "node": "Output: Job Analyzed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Handler: Ingest Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
