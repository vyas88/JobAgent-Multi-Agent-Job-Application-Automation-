{
  "name": "JobAgent - Workflow C: Pre-fill Form",
  "nodes": [
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "job_id",
              "value": "00000000-0000-0000-0000-000000000001"
            },
            {
              "name": "profile_id",
              "value": "00000000-0000-0000-0000-000000000002"
            },
            {
              "name": "resume_variant_id",
              "value": "00000000-0000-0000-0000-000000000003"
            }
          ]
        },
        "options": {}
      },
      "id": "c1d2e3f4-0003-4000-8000-000000000001",
      "name": "Manual Trigger (Prefill Input)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JOBAGENT_BASE_URL || 'http://host.docker.internal:8000' }}/applications/prefill",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"job_id\": \"{{ $json.job_id }}\",\n  \"profile_id\": \"{{ $json.profile_id }}\",\n  \"resume_variant_id\": \"{{ $json.resume_variant_id }}\"\n}",
        "options": {
          "neverError": true
        }
      },
      "id": "c1d2e3f4-0003-4000-8000-000000000002",
      "name": "POST /applications/prefill",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        500,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "jobagent-api-key",
          "name": "JobAgent API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $response.statusCode }}",
              "operation": "equal",
              "value2": 200
            }
          ]
        }
      },
      "id": "c1d2e3f4-0003-4000-8000-000000000003",
      "name": "Check Status == 200",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "pre_filled"
            },
            {
              "name": "application_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "review_artifact",
              "value": "={{ JSON.stringify($json.review_artifact) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c1d2e3f4-0003-4000-8000-000000000004",
      "name": "Push to Pending Review Queue",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error_status",
              "value": "={{ $response.statusCode }}"
            },
            {
              "name": "error_detail",
              "value": "={{ $json.detail || 'Form pre-fill failed' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "c1d2e3f4-0003-4000-8000-000000000005",
      "name": "Error Handler: Prefill Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        1000,
        400
      ]
    }
  ],
  "connections": {
    "Manual Trigger (Prefill Input)": {
      "main": [
        [
          {
            "node": "POST /applications/prefill",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /applications/prefill": {
      "main": [
        [
          {
            "node": "Check Status == 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Status == 200": {
      "main": [
        [
          {
            "node": "Push to Pending Review Queue",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Error Handler: Prefill Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
